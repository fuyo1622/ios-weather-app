<?xml version="1.0" encoding="utf-8"?>
<!-- The small widget: 2×2 cells; refreshed by Refresh.kt (WorkManager), not by Android's own timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.fuyo1622.taiwanweather.WidgetConfigActivity"
    android:description="@string/widget_small_about"
    android:initialLayout="@layout/widget_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
