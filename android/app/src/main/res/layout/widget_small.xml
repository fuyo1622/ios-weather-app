<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget: place, now, its weather, today's high and low, the rain line, and the bottom line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/place" style="@style/WidgetText.Dim" android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/temp" style="@style/WidgetText.Big" android:layout_width="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/icon" style="@style/WidgetText" android:layout_width="wrap_content" android:textSize="24sp" />
    </LinearLayout>

    <TextView android:id="@+id/condition" style="@style/WidgetText.Dim" android:textSize="12sp" />

    <TextView android:id="@+id/hilo" style="@style/WidgetText.Dim" android:textSize="12sp" />

    <TextView android:id="@+id/rain" style="@style/WidgetText.Rain" android:textSize="12sp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:id="@+id/bottom" style="@style/WidgetText.Dim" android:textSize="9sp" />
</LinearLayout>
